# Plantilla del .env que consume docker-compose.yml. NO pongas valores reales aqui: este
# archivo SI se versiona (.gitignore lo excluye de la regla `.env.*` con `!.env.example`).
#
# El .env de verdad no se escribe a mano. Se genera leyendo las cadenas de conexion de
# AWS Parameter Store, que es donde viven cifradas:
#
#   .\scripts\preparar-env-local.ps1
#
# Cada servicio usa su PROPIO rol Postgres, no una credencial compartida: si una se
# filtra, el alcance del dano queda acotado al schema de ese servicio.
#
# Formato de cada cadena, con el pooler de Supabase en modo TRANSACCION (puerto 6543):
#
#   postgresql://<rol>.<project_ref>:<password>@<pooler_host>:6543/postgres
#
# El usuario lleva el project-ref pegado al rol con un punto — es como Supavisor decide a
# que proyecto enrutar. Sin el, la conexion falla con "Tenant or user not found".

DATABASE_URL_INTAKE=postgresql://svc_intake.PROJECT_REF:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL_DISPATCH=postgresql://svc_dispatch.PROJECT_REF:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL_GEO=postgresql://svc_geo.PROJECT_REF:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL_NOTIFY=postgresql://svc_notify.PROJECT_REF:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
